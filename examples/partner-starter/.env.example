# Secret partenaire, délivré par PurrPlan. Ne quitte jamais le serveur.
PURRPLAN_PARTNER_SECRET=

# Secret HMAC que VOUS choisissez pour signer les webhooks entrants.
PURRPLAN_WEBHOOK_SECRET=un-secret-long-et-aleatoire

# URL publique de CE serveur. PurrPlan refuse toute URL de retour non
# publique : en développement, exposez le port par un tunnel https.
PUBLIC_URL=https://votre-tunnel.exemple.fr

PORT=4321
PURRPLAN_BASE_URL=https://app.purrplan.ai
